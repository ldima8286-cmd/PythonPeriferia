# Periferia: read access to input devices.
#
# This file is a template. Do not install it as is, the vendor and product ids
# below are placeholders. Generate a real rule from the hardware you actually
# have:
#
#   bash scripts/gen-udev-rules.sh             # print it
#   bash scripts/gen-udev-rules.sh --install   # write it and reload udev
#
# Check first whether you even need it. logind normally grants the logged-in
# user ACLs on the devices of their own seat, and if "periferia check" says the
# devices are readable, this file is unnecessary.
#
# TAG+="uaccess" is the part that matters. It hands the device to whoever is
# logged in on the active seat, the same mechanism used for /dev/snd. It is
# narrower than MODE="0666" and does not expose your keyboard to every user on
# the machine.
#
# REPLACEME_VENDOR and REPLACEME_PRODUCT are the values printed by:
#   udevadm info -q property -n /dev/input/event5 | grep -E 'ID_VENDOR_ID|ID_MODEL_ID'

ACTION=="add|change", KERNEL=="event*", SUBSYSTEM=="input", \
  ATTRS{idVendor}=="REPLACEME_VENDOR", ATTRS{idProduct}=="REPLACEME_PRODUCT", \
  TAG+="uaccess", MODE="0660"
